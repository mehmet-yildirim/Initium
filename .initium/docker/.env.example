# =============================================================================
# Initium Agent — operator env file
# =============================================================================
# You do not need to clone Initium. Save this as `.env` next to compose.yaml,
# fill the required block, then: docker compose up -d
#
#   curl -fsSL -o compose.yaml \
#     https://github.com/mehmet-yildirim/Initium/releases/latest/download/compose.yaml
#   curl -fsSL -o .env \
#     https://github.com/mehmet-yildirim/Initium/releases/latest/download/agent.env.example
# =============================================================================

# Optional — pin the image (default: ghcr.io/mehmet-yildirim/initium-agent:latest)
# INITIUM_IMAGE=ghcr.io/mehmet-yildirim/initium-agent:1.7.0

# ── Required ──────────────────────────────────────────────────────────────────
# The repo the agent clones, implements in, and opens PRs against.
GIT_REPO_URL=https://github.com/your-org/your-repo.git
GIT_BRANCH=main

# One AI provider — uncomment the group you use.
ANTHROPIC_API_KEY=sk-ant-...

# CLAUDE_CODE_USE_BEDROCK=1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1

# CLAUDE_CODE_USE_VERTEX=1
# CLOUD_ML_REGION=us-east5
# ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id

# Clone private repos, push branches, open PRs (classic PAT: repo scope).
GITHUB_TOKEN=

# ── Optional — identity ─────────────────────────────────────────────────────
# GIT_AUTHOR_NAME=Initium Agent
# GIT_AUTHOR_EMAIL=agent@noreply.local
# GIT_CLONE_DEPTH=50

# ── Optional — CLI (default: claude) ────────────────────────────────────────
# AGENT_CLI=claude
# CURSOR_API_KEY=

# ── Optional — issue tracker (needed for /groom to pick work) ───────────────
# JIRA_URL=https://your-company.atlassian.net
# JIRA_EMAIL=you@your-company.com
# JIRA_API_TOKEN=
# LINEAR_API_KEY=
# GITLAB_TOKEN=

# ── Optional — Slack escalations ────────────────────────────────────────────
# SLACK_BOT_TOKEN=
# SLACK_TEAM_ID=

# ── Optional — webhook (`docker compose --profile webhook up -d`) ───────────
# JIRA_WEBHOOK_SECRET=
# WEBHOOK_PORT=3001
# WEBHOOK_PATH=/jira-webhook
# JIRA_SERVER_IP=

# ── Optional — schedule (default: every 15 minutes) ─────────────────────────
# GROOM_CRON=*/15 * * * *
